# Where Warcon answers. Production: http://warcon:3000 (Docker network warcon_default).
# Local development against the mock (npm run dev:mock):
WARCON_BASE_URL=http://127.0.0.1:4100
# A Warcon org API key with the View capability only. The mock accepts "mock-token".
WARCON_TOKEN=mock-token
# This site's public origin, no trailing slash.
SITE_URL=http://localhost:3000
# Optional: Warcon server ids to show, in order. Blank: every server the key can see.
SERVER_IDS=
# true lets search engines index the site. Leave false on the temporary address.
ALLOW_INDEXING=false
# Optional: the loopback port the site is published on (default 3100; Warcon holds 3000).
# SITE_HOST_PORT=3100

# --- Account linking (optional) ---------------------------------------------------------------
# Leave all of these blank to run without sign-in, status tags and /api/priority.
# Discord application (Developer Portal > OAuth2). Add <SITE_URL>/auth/discord/callback as a redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The same application's bot, invited to the TEG server. Only reads members' roles; no intents needed.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Role ids for each priority tier, comma separated, as many as you like. Best tier wins.
# Prio 1 (Admin tag): moderators and WARDOGS staff
DISCORD_STAFF_ROLE_IDS=
# Prio 2 (Premium tag, gold name)
DISCORD_PREMIUM_ROLE_IDS=
# Prio 3 (Verified tag, pearl-blue name)
DISCORD_VERIFIED_ROLE_IDS=
# Signs sign-in cookies. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# Bearer key for GET /api/priority (the tier list for Bulkhead's queue). Blank: endpoint off.
PRIORITY_API_KEY=
# Where accounts.db is kept. Default ./data (in Docker, the site-data volume).
# DATA_DIR=./data
