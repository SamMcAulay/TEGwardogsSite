# Copy to .env and fill in. Never commit .env. `deploy/install.sh` does the copy and generates the
# feed tokens for you.

# --- Site ---------------------------------------------------------------------------------------
# Public URL, no trailing slash. Used for link previews, sitemap.xml and `npm run doctor`.
SITE_URL=https://stats.example.com
# Per-server poll interval in ms (min 2000).
POLL_INTERVAL_MS=5000
# Paths. Docker sets these itself; only change them for a bare-metal install.
# DATABASE_PATH=./data/teg-wardogs.db
# SERVERS_CONFIG=./config/servers.json

# --- Game servers -------------------------------------------------------------------------------
# One RCON password per server, named by `rcon.passwordEnv` in config/servers.json. From the server
# admin: `Password=` under [/Script/WDRCON.WDRCONSettings], or Saved/RCON/ADMIN-PASSWORD.txt.
# Leave empty until you have them; servers with a `query` block fall back to Steam query.
RCON_PASSWORD_EU1=
RCON_PASSWORD_NA1=

# One kill feed token per server, named by `feedTokenEnv`. Make them up (openssl rand -hex 32) and
# give each to the server admin to put in that server's ServerSettings.ini under [WDServerFeed].
FEED_TOKEN_EU1=
FEED_TOKEN_NA1=

# --- Optional -----------------------------------------------------------------------------------
# Steam Web API key (https://steamcommunity.com/dev/apikey) for player avatars.
STEAM_API_KEY=
# Discord channel webhook for "server offline / back online" alerts.
DISCORD_WEBHOOK_URL=
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Used by `docker compose --profile tunnel`.
TUNNEL_TOKEN=
# How many daily backups `scripts/backup.mjs` keeps.
BACKUP_KEEP=14
# Set to false on extra web replicas so only one process polls.
WORKER_ENABLED=true
DEMO_MODE=false
