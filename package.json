{
  "name": "teg-wardogs-stats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "mock": "node scripts/mock-warcon.mjs",
    "dev:mock": "node scripts/mock-warcon.mjs & MOCK=$!; next dev; kill $MOCK",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts",
    "postbuild": "cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
